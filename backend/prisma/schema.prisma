generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String?
  password  String
  tasks     Task[]
  offerLetters OfferLetter[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("Pending")
  priority    String    @default("Medium")
  startTime   DateTime?
  endTime     DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OfferLetter {
  id           String   @id @default(uuid())
  name         String
  position     String
  startDate    String
  endDate      String
  domain       String
  stipend      String
  location     String
  workingHours String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
